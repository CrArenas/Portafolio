---
import Socials from './Socials.astro';
import { ui } from '../data/i18n.js';
import { pages, pageUrl } from '../data/routes.js';
import { AUTHOR } from '../data/site.js';

const { lang, current, altUrl } = Astro.props;
const t = ui[lang];
const altLang = lang === 'es' ? 'en' : 'es';
const items = pages.map(p => ({ ...p, href: pageUrl(lang, p.id), label: t.nav[p.id] }));
---
<!-- Barra superior fija; en pantallas angostas los enlaces pasan al menú desplegable -->
<header class="site-header" transition:animate="none">
  <div class="container header-inner">
    <a class="brand" href={pageUrl(lang, 'home')}>
      <span class="brand-name">{AUTHOR}</span>
      <span class="brand-role">{t.spine.role}</span>
    </a>

    <nav class="main-nav" aria-label={t.navLabel}>
      <ul>
        {items.map(p => (
          <li>
            <a class:list={['nav-link', { active: p.id === current }]} href={p.href} aria-current={p.id === current ? 'page' : undefined}>{p.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <Socials />
      <a class="lang-btn" href={altUrl} hreflang={altLang} aria-label={t.langAria}>
        <span class:list={{ 'is-current': lang === 'es' }}>ES</span>
        <span class="lang-sep">/</span>
        <span class:list={{ 'is-current': lang === 'en' }}>EN</span>
      </a>
      <button class="hamburger" id="hamburger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-nav-menu">
    <ul class="container">
      {items.map(p => (
        <li>
          <a class:list={['mobile-link', { active: p.id === current }]} href={p.href} aria-current={p.id === current ? 'page' : undefined}>{p.label}</a>
        </li>
      ))}
    </ul>
    <div class="container mobile-menu-footer"><Socials /></div>
  </div>
</header>

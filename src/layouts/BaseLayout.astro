---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { ui, locales } from '../data/i18n.js';
import { AUTHOR } from '../data/site.js';
import '../styles/global.css';

// current: id de la página activa (ver src/data/routes.js)
// title/description: opcionales, para páginas con contenido propio (artículos)
const { lang, current, title: pageTitle, description = ui[lang].metaDescription, ogType = 'website' } = Astro.props;
const t = ui[lang];
const title = pageTitle
  ? `${pageTitle} — ${AUTHOR}`
  : current === 'home' ? t.docTitle : `${t.nav[current]} — ${AUTHOR}`;

// La misma ruta en cada idioma: /es/about <-> /en/about
const pathFor = (l) => Astro.url.pathname.replace(`/${lang}/`, `/${l}/`).replace(new RegExp(`^/${lang}$`), `/${l}`);
const altLang = lang === 'es' ? 'en' : 'es';

// URLs absolutas (site en astro.config.mjs): LinkedIn y Google las exigen
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#0A0D16" />

    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    {locales.map(l => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
    <link rel="alternate" type="application/rss+xml" title={`${AUTHOR} — ${t.nav.dev}`} href={`/${lang}/rss.xml`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <ClientRouter />
  </head>
  <body>
    <!-- Las partículas de fondo sobreviven a la navegación entre páginas -->
    <div class="bg-wrap" transition:persist="bg" aria-hidden="true">
      <canvas id="bg-canvas"></canvas>
    </div>
    <Navigation lang={lang} current={current} altUrl={pathFor(altLang)} />
    <main class="page container" id={`page-${current}`}>
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>

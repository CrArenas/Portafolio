---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, langPaths, loc } from '../../data/i18n.js';
import { skillGroups } from '../../data/skills.js';
import { AUTHOR } from '../../data/site.js';

export const getStaticPaths = langPaths;

const { lang } = Astro.params;
const t = ui[lang];
const L = (value) => loc(value, lang);
---
<BaseLayout lang={lang} current="about">
  <div class="about-header">
    <div class="profile-photo-wrap">
      <img src="/images/profile.jpg" alt={AUTHOR} class="profile-photo" />
      <div class="profile-photo-ring"></div>
    </div>
    <div>
      <div class="section-eyebrow">{t.about.eyebrow}</div>
      <h1 class="section-title" set:html={t.about.title} />
    </div>
  </div>

  <div class="about-layout">
    <div class="about-body">
      {t.about.body.map(p => <p class="section-body">{p}</p>)}
    </div>

    <aside class="about-side">
      <div class="side-block">
        <h2 class="block-label">{t.about.educationLabel}</h2>
        <ul class="education-list">
          {t.about.education.map(e => (
            <li>
              <span class="education-title">{e.title}</span>
              {e.note && <span class="education-note">{e.note}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div class="side-block">
        <h2 class="block-label">{t.about.skillsLabel}</h2>
        <div class="skill-groups">
          {skillGroups.map(g => (
            <div class="skill-group">
              <div class="skill-group-title">{L(g.title)}</div>
              <div class="chips">
                {g.items.map(item => <span class="chip">{L(item)}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

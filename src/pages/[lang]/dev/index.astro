---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { ui, langPaths } from '../../../data/i18n.js';
import { getPosts } from '../../../utils/content.js';

export const getStaticPaths = langPaths;

const { lang } = Astro.params;
const t = ui[lang];
const posts = await getPosts(lang);
// Tecnologías de todos los artículos, las más usadas primero
const counts = posts.flatMap(p => p.data.stack).reduce((m, s) => m.set(s, (m.get(s) ?? 0) + 1), new Map());
const stack = [...counts.keys()].sort((a, b) => counts.get(b) - counts.get(a) || a.localeCompare(b));
---
<BaseLayout lang={lang} current="dev">
  <div class="section-eyebrow">{t.dev.eyebrow}</div>
  <h1 class="section-title" set:html={t.dev.title} />
  <p class="section-body">{t.dev.body}</p>

  {posts.length === 0 ? (
    <p class="dev-empty">{t.dev.empty}</p>
  ) : (
    <>
      {/* El filtrado ocurre en el navegador (ver scripts/app.js) */}
      <div class="dev-filters" role="group" aria-label={t.dev.filterLabel}>
        <button class="filter-chip" type="button" data-filter="" aria-pressed="true">{t.dev.filterAll}</button>
        {stack.map(s => <button class="filter-chip" type="button" data-filter={s} aria-pressed="false">{s}</button>)}
      </div>
      <div class="posts-list">
        {posts.map(post => <PostCard post={post} lang={lang} />)}
      </div>
    </>
  )}
</BaseLayout>
